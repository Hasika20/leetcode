class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class SingleLinkedList:
    def __init__(self):
        self.head = None

    def insert_node(self, num, pos):
        node = Node(num)

        if not self.head or pos <= 1:
            node.next = self.head
            self.head = node
            return

        length = self.len_list()

        if pos > length:
            temp = self.head
            while temp.next:
                temp = temp.next
            temp.next = node
            return

        temp = self.head
        i = 1
        while i < pos - 1:
            temp = temp.next
            i += 1

        node.next = temp.next
        temp.next = node
    
    def delete(self, num):
        temp = self.head
        
        if temp and temp.data == num:
            self.head = temp.next
            return
        
        prev = None
        while temp and temp.data != num:
            prev = temp
            temp = temp.next
            
        if not temp:
            return
        
        prev.next = temp.next
    
    def search(self, key):
        temp = self.head
        while temp:
            if temp.data == key:
                return True
            temp = temp.next
        return False
            

    def len_list(self):
        count = 0
        temp = self.head
        while temp:
            count += 1
            temp = temp.next
        return count

    def print_list(self):
        temp = self.head
        if not temp:
            print("List is empty")
            return
        while temp:
            print(temp.data, end="->")
            temp = temp.next
        print("None")
        
s = SingleLinkedList()
s.insert_node(1, 4)
s.insert_node(2, 1)
s.insert_node(3, 2)
s.delete(2)
print(s.search(1))
print("Length of linkedlist:", s.len_list())
s.print_list()
